# Telegram bot token from @BotFather.
BOT_TOKEN=

# Telegram webhook public domain.
# Use your Railway public domain, for example:
# WEBHOOK_DOMAIN=https://your-service.up.railway.app
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram/webhook

# Optional. If empty, the app derives a stable secret from BOT_TOKEN.
WEBHOOK_SECRET_TOKEN=

# MTProto uploader secrets. The server uses these to upload downloaded files
# to Telegram. Generate TG_SESSION once with: ./out --setup-session
TG_APP_ID=
TG_APP_HASH=
TG_SESSION=

# MySQL connection string. The bot creates the user_languages table automatically.
# MYSQL_URL takes priority (recommended for Railway). Format: mysql://user:password@host:3306/database
# MYSQL_DSN is the traditional go-sql-driver format. Format: user:password@tcp(host:3306)/database?parseTime=true&charset=utf8mb4
MYSQL_URL=
MYSQL_DSN=

# Optional. Base64-encoded Netscape cookies file for YouTube.
# Cookies are only a fallback: the bot tries the cookieless download method first.
# Easiest way to produce this value: load the bundled cookie-extension/ in Chrome,
# sign in to YouTube, click Generate, and paste the result here.
# (You can also export with any "Get cookies.txt LOCALLY" extension and base64-encode the file.)
# Re-export when the bot reports the cookies have been rotated or are invalid.
# YT_COOKIES_B64=

# Optional. Full path to yt-dlp. If empty, the bot uses PATH or downloads yt-dlp automatically.
# YT_DLP_PATH=

# Optional. Directory or path to the ffmpeg binary, passed to yt-dlp as
# --ffmpeg-location. Leave empty to use ffmpeg from PATH. ffmpeg is required on
# the host to merge video+audio and to extract MP3 audio.
# FFMPEG_LOCATION=
